{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"], "types": ["vite/client"],
    "allowImportingTsExtensions": true, "skipLibCheck": true
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx"]
}
