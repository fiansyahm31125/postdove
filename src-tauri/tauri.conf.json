{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postdove",
  "version": "0.1.3",
  "identifier": "com.postdove.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"Postdove","width":1200,"height":780,"minWidth":720,"minHeight":480}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {"active": true, "icon": ["icons/icon.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"]}
}
